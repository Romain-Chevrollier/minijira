# Copier ce fichier en .env (non versionné) puis adapter si besoin.
# Le préfixe postgresql+psycopg indique à SQLAlchemy d'utiliser le driver psycopg 3.

# Base de dev, utilisée par l'app et par Alembic
DATABASE_URL=postgresql+psycopg://minijira:minijira@localhost:5432/minijira

# Base de test, utilisée par pytest
TEST_DATABASE_URL=postgresql+psycopg://minijira:minijira@localhost:5432/minijira_test
